{
  "name": "ai-coding-agent-observatory",
  "private": true,
  "version": "0.1.0",
  "description": "Observability platform for AI coding agents (Claude Code, Codex CLI, Gemini CLI) built on OpenTelemetry.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/dashboard",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
