# Copy to .env and adjust as needed. docker-compose.yml reads this file for
# local runs; nothing here is required to be secret in local mode.
#
# This project does not simulate telemetry. Point a real Claude Code, Codex
# CLI, or Gemini CLI session at the collector's OTLP endpoints below -- see
# docs/CONNECT_AGENTS.md for exact per-agent configuration.

# ---- Dashboard (apps/dashboard) ----
PORT=3000
DATABASE_PATH=/data/observatory.sqlite

# ---- OTel Collector (infra/docker) ----
# Ports exposed to the host so agents running outside Docker can reach the
# collector directly.
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ---- OTel Collector cloud exporters (only used with otel-collector-cloud.yaml) ----
# Required only for `docker compose -f infra/docker/docker-compose.cloud.yml up`.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDWATCH_LOG_GROUP=/ai-observatory/otel
CLOUDWATCH_NAMESPACE=AIObservatory
