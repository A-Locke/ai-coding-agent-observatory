# Built from the monorepo root: docker build -f infra/docker/Dockerfile.dashboard .
# node:22-bookworm-slim (glibc, Active LTS) rather than Alpine or the host's
# Node 24 -- see ADR 0001, D7.

FROM node:22-bookworm-slim AS deps
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

FROM node:22-bookworm-slim AS builder
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY . .
ENV DATABASE_PATH=/tmp/build.sqlite
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=apps/dashboard

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV DATABASE_PATH=/data/observatory.sqlite
RUN mkdir -p /data
COPY --from=builder /repo/apps/dashboard/.next/standalone ./
COPY --from=builder /repo/apps/dashboard/.next/static ./apps/dashboard/.next/static
EXPOSE 3000
CMD ["node", "apps/dashboard/server.js"]
